{
  "name": "learn-to-code",
  "version": "0.1.0",
  "private": true,
  "description": "A Markdown documentation site prepared for GitHub Pages",
  "scripts": {
    "prestart": "node scripts/reading-exports.cjs",
    "start": "docusaurus start --host 127.0.0.1",
    "prebuild": "node scripts/reading-exports.cjs",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 4173 --no-open",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check:links": "python3 scripts/check_site.py",
    "test": "playwright test",
    "check": "npm run check:skills && npm run lint && npm run build && npm run check:links && npm test",
    "content:refresh": "node scripts/import-course.cjs",
    "skills:sync": "node scripts/sync-skills.cjs",
    "check:skills": "node scripts/sync-skills.cjs --check"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "gray-matter": "4.0.3",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  },
  "license": "MIT"
}
